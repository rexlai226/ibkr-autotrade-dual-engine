# ==============================================================================
# AutoTrade 系統環境變數配置範本 (.env.example)
# 複製此檔案為 .env 並填入相應的金鑰與安全設置
# ==============================================================================

# 1. 外部安全訪問 PIN 碼 (當從 Cloudflare 公網訪問時，需輸入此 6 位數 PIN 碼解鎖操作)
WEB_ACCESS_PIN=888888

# 2. Telegram 即時交易與警報機器人推播配置 (方案 C)
# 取得方式：
# - 搜尋 Telegram 官方 @BotFather，輸入 /newbot 建立機器人，獲取 API Token
# - 搜尋 Telegram 官方 @userinfobot 或將訊息傳送給機器人，獲取您的個人 Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Telegram 推播開關設置 (true / false)
TELEGRAM_NOTIFY_TRADES=true
TELEGRAM_NOTIFY_INCIDENTS=true
TELEGRAM_NOTIFY_HEARTBEAT=true
TELEGRAM_HEARTBEAT_INTERVAL_MIN=60

# 4. Telegram 警報過濾代碼 (以逗號分隔，低風險或無害常規代碼將不推播至 Telegram)
# 預設已內建過濾: 162(HMDS查詢取消/無害IP衝突), 326(ClientId輪替), 2103,2105,2107,2108,2119,2219(數據農場重連), 10167,10168(延遲行情)
TELEGRAM_IGNORE_CODES=162,326,2103,2104,2105,2106,2107,2108,2119,2158,2219,10167,10168

# 5. Cloudflare Tunnel 自定義配置 (選填，若留空則自動使用免費 Quick Tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=

# 6. IBKR 帳戶顯示代號與雲端報告資料夾 (選填)
# IB_ACCOUNT_ID=IBKR-PAPER
# GDRIVE_FOLDER_ID=

# 7. Google Sheets 雲端秒級同步 Webhook URL (支援無人值守 Linux 雲端 VM 直接雙向同步)
# 填入由 Google Apps Script 部署之 Web App 網址 (https://script.google.com/macros/s/.../exec)
GOOGLE_SHEETS_WEBHOOK_URL=

# 8. CME / NYMEX (MES, MNQ, MCL) 與 HKFE (MHI) 分品種開休市排程 (預設 true：美東每日 17:00-18:00 及週末休市自動暫停斷線，開市自動恢復連線)
ENABLE_MARKET_SCHEDULE=true
ROLL_DAYS_BEFORE_EXPIRY=3
# MES_CONTRACT_MONTH=
# MNQ_CONTRACT_MONTH=
# MHI_CONTRACT_MONTH=
# MCL_CONTRACT_MONTH=
